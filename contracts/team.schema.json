{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "脱敏团队资料",
  "type": "object",
  "required": ["team_id", "domain", "source_market", "source_timezone", "destination_timezone", "languages", "head_member_id", "members", "kinship_edges", "rooming_request", "vehicle_request"],
  "properties": {
    "team_id": {"type": "string", "minLength": 1},
    "domain": {"const": "gulf-inbound-travel"},
    "source_market": {"type": "string", "minLength": 2},
    "source_timezone": {"type": "string", "minLength": 1},
    "destination_city": {"type": "string"},
    "destination_timezone": {"type": "string", "minLength": 1},
    "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "head_member_id": {"type": "string", "minLength": 1},
    "preferences": {"type": "object"},
    "members": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["member_id", "token_ref", "family_unit", "age_band", "diet", "kinship_to_head"],
        "properties": {
          "member_id": {"type": "string"},
          "token_ref": {"type": "string"},
          "family_unit": {"type": "string"},
          "age_band": {"enum": ["adult", "child", "senior"]},
          "diet": {"type": "string"},
          "kinship_to_head": {"type": "string"},
          "kinship_label": {"type": "object"},
          "accessibility": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "kinship_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relation"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "relation": {"type": "string"}
        }
      }
    },
    "rooming_request": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "room_type", "occupants"],
        "properties": {
          "unit_id": {"type": "string"},
          "room_type": {"type": "string"},
          "occupants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "requirements": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "vehicle_request": {
      "type": "object",
      "required": ["scope", "charter", "min_capacity", "requirements"],
      "properties": {
        "scope": {"type": "string"},
        "charter": {"type": "boolean"},
        "min_capacity": {"type": "integer", "minimum": 1},
        "requirements": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "additionalProperties": false
}

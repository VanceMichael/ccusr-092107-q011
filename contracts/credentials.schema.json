{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "证件令牌登记（脱敏）",
  "type": "object",
  "required": ["tokens"],
  "properties": {
    "note": {"type": "string"},
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["token_ref", "member_id", "doc_type", "issuing_country", "doc_number_masked", "demo_hash", "scopes", "status"],
        "properties": {
          "token_ref": {"type": "string"},
          "member_id": {"type": "string"},
          "doc_type": {"type": "string"},
          "issuing_country": {"type": "string"},
          "doc_number_masked": {"type": "string"},
          "demo_hash": {"type": "string"},
          "scopes": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["active", "revoked"]},
          "expires_on": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": false
}

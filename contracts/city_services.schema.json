{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "城市服务能力目录（报价为多币种）",
  "type": "object",
  "required": ["city", "timezone", "services"],
  "properties": {
    "note": {"type": "string"},
    "city": {"type": "string"},
    "timezone": {"type": "string"},
    "airport": {"type": "object"},
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["service_id", "category", "supplier_id", "supplier_name", "name", "features"],
        "properties": {
          "service_id": {"type": "string"},
          "category": {"enum": ["flight", "hotel", "vehicle", "restaurant", "attraction", "local_staff", "local_service"]},
          "supplier_id": {"type": "string"},
          "supplier_name": {"type": "object"},
          "name": {"type": "object"},
          "features": {"type": "array", "items": {"type": "string"}},
          "price": {
            "type": "object",
            "required": ["currency", "amount", "unit"],
            "properties": {
              "currency": {"type": "string", "minLength": 3},
              "amount": {"type": "number", "minimum": 0},
              "unit": {"type": "string"}
            }
          },
          "seats_available": {"type": "integer", "minimum": 0},
          "capacity": {"type": "integer", "minimum": 1},
          "charter_scope": {"type": "string"},
          "room_types": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["room_type", "inventory", "occupancy", "price"],
              "properties": {
                "room_type": {"type": "string"},
                "inventory": {"type": "integer", "minimum": 0},
                "occupancy": {"type": "integer", "minimum": 1},
                "features": {"type": "array", "items": {"type": "string"}},
                "price": {"type": "object"}
              }
            }
          },
          "origin": {"type": "string"},
          "destination": {"type": "string"},
          "departs_at": {"type": "string"},
          "arrives_at": {"type": "string"},
          "window": {"type": "object"},
          "last_order_local": {"type": "string"},
          "cancel_reason_supported": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "additionalProperties": false
}

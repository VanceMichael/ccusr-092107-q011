{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "脱敏家庭团队",
  "type": "object",
  "required": [
    "team_id", "home_city", "home_timezone", "destination",
    "destination_timezone", "head_id", "members"
  ],
  "properties": {
    "team_id": {"type": "string", "minLength": 1},
    "home_city": {"type": "string"},
    "home_timezone": {"type": "string"},
    "destination": {"type": "string"},
    "destination_timezone": {"type": "string"},
    "head_id": {"type": "string"},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "member_id", "member_code", "token", "age_band"
        ],
        "properties": {
          "member_id": {"type": "string"},
          "member_code": {"type": "string", "pattern": "^G-\\d+$"},
          "age_band": {"enum": ["adult", "child", "infant"]},
          "diets": {"type": "array", "items": {"enum": ["halal", "vegetarian", "no_beef"]}},
          "languages": {"type": "array", "items": {"enum": ["ar", "en", "zh"]}},
          "access_needs": {
            "type": "array",
            "items": {
              "enum": [
                "wheelchair", "walker", "hearing_assist",
                "ground_floor", "baby_crib", "child_seat"
              ]
            }
          },
          "token": {
            "type": "object",
            "required": ["token_id", "kind", "masked_ref", "issuer", "issued_at"],
            "properties": {
              "token_id": {"type": "string"},
              "kind": {"enum": ["passport_visa", "emirates_id", "group_pass"]},
              "masked_ref": {
                "type": "string",
                "pattern": "^.*\\*+.*$",
                "description": "必须为脱敏指纹，含掩码字符"
              },
              "issuer": {"type": "string"},
              "issued_at": {"type": "string"},
              "expires_at": {"type": ["string", "null"]},
              "status": {"enum": ["active", "suspended", "revoked"]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["a", "b", "role"],
        "properties": {
          "a": {"type": "string"},
          "b": {"type": "string"},
          "role": {
            "enum": ["head", "spouse", "child", "parent", "sibling", "other"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

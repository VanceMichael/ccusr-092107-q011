{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "编排政策（定金/取消/延误/阶段/最小披露）",
  "type": "object",
  "required": ["deposit_policy", "cancellation_policy", "delay_policy", "stages", "minimum_disclosure"],
  "properties": {
    "deposit_policy": {
      "type": "object",
      "required": ["deposit_pct", "deposit_currency"],
      "properties": {
        "deposit_pct": {"type": "integer", "minimum": 0, "maximum": 100},
        "deposit_currency": {"type": "string"},
        "balance_currencies": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    },
    "cancellation_policy": {
      "type": "object",
      "required": ["tiers", "refund_currency_rule"],
      "properties": {
        "cross_border": {"type": "boolean"},
        "tiers": {"type": "array", "minItems": 1,
          "items": {"type": "object", "required": ["before_days", "supplier_keeps_pct", "refund_pct"]}},
        "refund_currency_rule": {"type": "string"},
        "carrier_fault_refund_pct": {"type": "integer"},
        "note": {"type": "string"}
      }
    },
    "delay_policy": {"type": "object"},
    "stages": {
      "type": "array", "minItems": 5,
      "items": {
        "type": "object",
        "required": ["code", "name"],
        "properties": {"code": {"type": "string"}, "name": {"type": "object"}}
      }
    },
    "minimum_disclosure": {"type": "object"}
  },
  "additionalProperties": false
}
